{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lovechapter-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // Never expose pre-cutover or historical versions on public Version URLs.
  "preview_urls": false,
  // Production Hyperdrive has query caching disabled so account and membership
  // reads always reflect revocations.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "1ab093151ae1492ea4c18d180637e23c" },
  ],
  "vars": {
    "NODE_ENV": "production",
    "AUTH_MODE": "local",
    "RESEND_FROM_EMAIL": "notifications@lovechapter.net",
  },
  "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": false,
      // Use a separate, cache-disabled Hyperdrive configuration for staging.
      "hyperdrive": [
        { "binding": "HYPERDRIVE", "id": "e55ad44368d04224aa7ba4af95173e23" },
      ],
      "vars": { "NODE_ENV": "production", "AUTH_MODE": "local" },
      // Send queued auth mail and clean expired records on staging.
      "triggers": { "crons": ["* * * * *", "*/15 * * * *"] },
    },
  },
  // Keep dashboard-managed secrets when updating Worker code.
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false },
  },
}

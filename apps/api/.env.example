# Local-development example. Production is supplied by systemd and must use
# NODE_ENV=production with AUTH_MODE=local only after every deployment gate.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgres://app_user:replace_me@127.0.0.1:5432/lovechapter
DATABASE_POOL_MAX=6
PUBLIC_WEB_ORIGIN=http://localhost:3000
AUTH_MODE=development
DEV_AUTH_SUBJECT=local-couple
DEV_AUTH_DISPLAY_NAME=Local Couple
DEV_AUTH_EMAIL=couple@example.test
# Generate independent 32-byte base64url values for each secret. The values
# below are non-random placeholders and must never be deployed.
WEB_PROXY_SHARED_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
RATE_LIMIT_HMAC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBA
AUTH_TOKEN_ACTIVE_KEY_VERSION=1
AUTH_TOKEN_HMAC_KEYS={"1":"CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCA"}

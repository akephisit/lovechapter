{
  "name": "@lovechapter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --sourcemap=linked --outdir=dist",
    "start": "bun dist/server.js",
    "smoke:bun": "bun src/bun-runtime-smoke.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@clerk/backend": "3.18.1",
    "@lovechapter/contracts": "0.1.0",
    "@lovechapter/database": "0.1.0",
    "@lovechapter/domain": "0.1.0",
    "elysia": "2.0.0-beta.16",
    "exact-mirror": "1.2.6",
    "openapi-types": "12.1.3",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@types/bun": "1.4.2"
  }
}

# The job process has its own bounded pool and runtime environment file.
DATABASE_URL=postgres://jobs_user:replace_me@127.0.0.1:5432/lovechapter
DATABASE_POOL_MAX=2
PUBLIC_WEB_ORIGIN=http://localhost:3000
AUTH_TOKEN_ACTIVE_KEY_VERSION=1
# Retain old and active versions during rotation; use real independent keys.
AUTH_TOKEN_HMAC_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}
RESEND_API_KEY=re_replace_with_resend_api_key
RESEND_FROM_EMAIL=auth@example.test
